{
  "name": "void-games-server",
  "version": "1.0.0",
  "description": "Void Games API - Express backend for the Void Games gaming platform",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "dev:worker": "wrangler dev",
    "build:worker": "tsc --noEmit",
    "deploy:worker": "wrangler deploy",
    "generate:sitemap": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "nodemon": "^3.1.9",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
